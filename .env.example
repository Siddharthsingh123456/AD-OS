# --- Required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ai-developer-os?retryWrites=true&w=majority   # leave empty locally to use an embedded database in .data/
ANTHROPIC_API_KEY=sk-ant-...        # or leave empty and let each user paste their own key in Settings

# --- Strongly recommended in production ---
JWT_SECRET=                          # 32+ random characters:  openssl rand -hex 32

# --- Optional ---
ANTHROPIC_MODEL=claude-sonnet-5-5
ENABLE_WEB_SEARCH=false              # true = Research Agent may use Anthropic web search
GITHUB_TOKEN=                        # raises GitHub Analytics / repo import rate limits
CORS_ORIGIN=                         # comma-separated origins allowed to call the API cross-origin (same-origin needs nothing)
ML_SERVICE_URL=                      # e.g. https://your-ml-service.onrender.com (see ml-service/)
ML_SERVICE_KEY=                      # shared secret sent as x-api-key to the ML service
PORT=5000

# --- Production hardening (optional) ---
UPSTASH_REDIS_REST_URL=              # shared rate-limit counter for serverless (https://upstash.com)
UPSTASH_REDIS_REST_TOKEN=
ERROR_WEBHOOK_URL=                   # Slack/Discord/JSON endpoint that receives server errors and browser crashes
PUBLIC_URL=                          # e.g. https://app.example.com (used for billing redirects)

# --- Billing (optional, test mode first) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# --- Demo (optional) ---
DEMO_MODE=false                      # true = "Try the demo" button on sign-in (run `npm run seed` once)

# --- Skip for now / local mode ---
GUEST_LOGIN=                         # default: on locally, off in production. true/false overrides
GUEST_ADMIN=                         # default: guest is admin locally (all pages visible), normal user in production
EMBEDDED_DB=                         # false = never start the embedded MongoDB
